# Banco de dados (usado pelo docker-compose)
POSTGRES_DB=agendador
POSTGRES_USER=agendador
POSTGRES_PASSWORD=agendador

# Aplicação Spring Boot (execução local com Maven, fora do Docker)
# O Postgres do docker-compose expõe a porta 5433 no host.
DB_URL=jdbc:postgresql://localhost:5433/agendador
DB_USER=agendador
DB_PASSWORD=agendador

# Origens liberadas no CORS (front-end)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
